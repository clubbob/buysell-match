# buysell-match 전용 Firebase 프로젝트를 새로 만든 뒤 값을 넣습니다.
# job365 / lumi365 Firebase는 재사용하지 마세요.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 서버 API(구매 신청·확정·관리자)용 — Firebase 콘솔 서비스 계정 JSON 전체를 한 줄로
FIREBASE_SERVICE_ACCOUNT_KEY=

# Rules 배포: firebase deploy --only firestore:rules,storage (firebase-tools 필요)

# 로컬: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 사이트 하단·약관 사업자 정보 (전자상거래법 제10조·제20조)
NEXT_PUBLIC_COMPANY_LEGAL_NAME=새봄인터내셔널
NEXT_PUBLIC_COMPANY_REPRESENTATIVE=박진희
NEXT_PUBLIC_COMPANY_ADDRESS=서울특별시 서초구 신반포로 20, 110동 201호
NEXT_PUBLIC_COMPANY_EMAIL=clubbob@naver.com
NEXT_PUBLIC_COMPANY_PHONE=010-6391-4520
NEXT_PUBLIC_COMPANY_BUSINESS_NUMBER=129-09-53285
NEXT_PUBLIC_COMPANY_MAIL_ORDER_REGISTRATION=신고 면제
NEXT_PUBLIC_COMPANY_PRIVACY_OFFICER=고형석

# 국세청 사업자등록 상태조회 (공공데이터포털 일반 인증키)
NTS_BUSINESS_SERVICE_KEY=
